---
import Mockup from '../../layouts/Mockup.astro';
import Resume from '../../components/Resume.astro';
import Credentials from '../../components/Credentials.astro';
import Credit from '../../components/Credit.astro';
import { profile as p } from '../../data/profile';
import '../../styles/portal.css';
---
<Mockup title="2003 personal portal" theme="portal">
  <div class="portal-shell">
    <div class="utility"><span>Welcome to my corner of the web.</span><a href={`mailto:${p.email}`}>Get in touch</a></div>
    <header class="portal-header"><div class="speaker speaker-left" aria-hidden="true"></div><div class="wordmark"><span class="wordmark-small">computer science & cybersecurity</span><h1>BRYSON<br /><span>NEWMAN</span></h1><span class="wordmark-signoff">Clemson, SC / Personal homepage</span></div><div class="speaker speaker-right" aria-hidden="true"></div><span class="header-star" aria-hidden="true">✦</span></header>
    <nav class="portal-nav" aria-label="Main navigation"><a href="#profile">Home</a><a href="#experience">Experience</a><a href="#cyber-team">Cyber defense</a><a href="#skills">Skills</a><a href={p.pdf}>Resume PDF ↓</a></nav>
    <div class="welcome-strip"><span>You're tuned in to Bryson Newman's homepage.</span><a href={p.github}>Find me on GitHub</a></div>
    <main id="main" class="portal-columns">
      <aside class="portal-left">
        <section class="link-panel"><h2>Look around</h2><nav aria-label="Profile sections"><a href="#profile">★ My profile</a><a href="#experience">★ Work experience</a><a href="#cyber-team">★ Cyber defense team</a><a href="#education">★ Education</a><a href="#skills">★ Skills & tools</a></nav></section>
        <section class="contact-panel"><h2>Keep in touch</h2><a href={`mailto:${p.email}`}>Email Bryson</a><a href={p.github}>GitHub / Bmanbro</a><a href={p.linkedin}>LinkedIn / NewmanB</a><a href={`tel:${p.phone}`}>{p.phone}</a></section>
        <a class="resume-badge" href={p.pdf} download><span>Take a copy</span><strong>RESUME</strong><span>Download the PDF ↓</span></a>
        <div class="mini-disc" aria-hidden="true"><span>BN</span></div>
        <p class="left-note">Thanks for stopping by.<br />Have a look around.</p>
      </aside>
      <div class="portal-center">
        <section id="profile" class="portal-feature"><h2>Meet Bryson</h2><div class="feature-art"><div class="feature-type">SECURITY.<br />CODE.<br /><span>CURIOSITY.</span></div><img src="/images/cd-player-cutout.png" alt="Silver portable CD player" width="688" height="664" /><span class="feature-sticker">Clemson<br />CS student</span></div><div class="feature-copy"><h3>Hi, I'm Bryson.</h3><p>{p.intro}</p><a href={`mailto:${p.email}`}>Let's talk</a></div></section>
        <Resume />
      </div>
      <aside class="portal-right"><Credentials /><div class="firewall-sticker"><span>Clemson Cyber Defense Team</span><strong>FIREWALL<br />LEAD</strong><span>Spring 2024 – Present</span></div><a class="email-sticker" href={`mailto:${p.email}`}>Say hello!</a></aside>
    </main>
    <footer class="portal-footer"><span>Bryson Newman</span><a href={p.pdf}>Original resume</a><a href="#main">Back to top ↑</a></footer>
    <Credit />
  </div>
</Mockup>
