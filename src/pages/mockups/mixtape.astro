---
import Mockup from '../../layouts/Mockup.astro';
import Resume from '../../components/Resume.astro';
import Credentials from '../../components/Credentials.astro';
import Credit from '../../components/Credit.astro';
import { profile as p } from '../../data/profile';
import '../../styles/mixtape.css';
---
<Mockup title="Mixtape desktop" theme="mixtape">
  <div class="desk">
    <div class="desk-note">Computer science. Cybersecurity. Clemson.</div>
    <div class="jewel-case">
      <div class="case-spine" aria-hidden="true">BRYSON NEWMAN • THE RESUME • BRYSON NEWMAN</div>
      <div class="case-content">
        <header class="case-header"><span class="disc-logo">BN<span>compact profile</span></span><a href={`mailto:${p.email}`}>Email me</a><a class="metal-button" href={p.pdf} download>↓ Resume PDF</a></header>
        <main id="main">
          <section class="album-cover" aria-labelledby="name">
            <div class="cover-grid" aria-hidden="true"></div>
            <p class="cover-caption">The computer science & cybersecurity edition</p>
            <h1 id="name">BRYSON<br /><span>NEWMAN</span></h1>
            <div class="disc" aria-hidden="true"><div class="disc-label">BRYSON NEWMAN<br /><strong>THE RESUME</strong><br />COMPUTER SCIENCE<br />& CYBERSECURITY</div><div class="disc-hole"></div></div>
            <span class="cover-sticker">Clemson<br />University</span>
            <p class="cover-bottom">Offensive security intern / Firewall lead</p>
          </section>
          <div class="liner-layout">
            <aside class="track-sidebar">
              <nav aria-label="Resume sections"><h2>Track list</h2><a href="#profile"><span>01</span> Profile</a><a href="#experience"><span>02</span> Experience</a><a href="#cyber-team"><span>03</span> Cyber defense</a><a href="#education"><span>04</span> Education</a><a href="#skills"><span>05</span> Skills</a></nav>
              <div class="sidebar-links"><a href={p.github}>GitHub / Bmanbro</a><a href={p.linkedin}>LinkedIn / NewmanB</a><a href={`tel:${p.phone}`}>{p.phone}</a></div>
              <div class="hardware-photo"><img src="/images/cd-player-cutout.png" alt="Silver portable CD player" width="688" height="664" /><span>Made for a closer listen.</span></div>
              <Credentials />
            </aside>
            <div class="liner-notes">
              <section id="profile" class="profile-note"><span class="insert-label">Meet the person behind the profile</span><h2>Hi, I'm Bryson.</h2><p>{p.intro}</p><a href={`mailto:${p.email}`}>{p.email}</a></section>
              <div class="insert-divider"><span>Liner notes</span><span>Read all the way through ↓</span></div>
              <Resume />
            </div>
          </div>
        </main>
        <footer class="case-footer"><span>BRYSON NEWMAN / CLEMSON, SC</span><a href={p.pdf}>Open the original resume</a><span class="barcode" aria-hidden="true"></span></footer>
      </div>
    </div>
    <Credit />
  </div>
</Mockup>
