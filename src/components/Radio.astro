<div class="radio" data-radio data-playing="false" hidden>
  <button type="button" id="radio-toggle" aria-label="Gorillaz radio" aria-pressed="false" aria-controls="radio-panel" title="Play Gorillaz quietly">Gorillaz ▷</button>
  <input type="range" id="radio-volume" min="0" max="100" step="1" value="6" aria-label="Radio volume" aria-valuetext="6%" title="Volume: 6%" />
  <div class="equalizer" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
</div>
<section id="radio-panel" class="radio-panel is-active" popover="manual" aria-labelledby="radio-title">
  <div class="xp-titlebar">
    <h2 id="radio-title">Gorillaz radio</h2>
    <div class="window-controls"><button type="button" data-radio-close aria-label="Close radio and stop music" title="Stop and close"><span aria-hidden="true">×</span></button></div>
  </div>
  <div class="radio-video" data-radio-video></div>
  <p class="radio-status" role="status" aria-live="polite" data-radio-status></p>
  <div class="radio-toolbar">
    <button type="button" data-radio-next disabled>Next track »</button>
    <a href="https://www.youtube.com/watch?v=04mfKJWDSzI" target="_blank" rel="noopener noreferrer">Open on YouTube ↗</a>
  </div>
</section>
<noscript><a class="radio-fallback" href="https://www.youtube.com/@Gorillaz" target="_blank" rel="noopener noreferrer">Gorillaz on YouTube ↗</a></noscript>
<script>import '../scripts/radio';</script>
