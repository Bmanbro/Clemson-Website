---
import { themes, desktopEras } from '../data/themes';
---
<fieldset class="theme-picker" data-theme-picker hidden>
  <legend>Desktop theme</legend>
  <div class="theme-buttons" role="group" aria-label="Choose a desktop theme">
    {themes.map(theme => (
      <button type="button" data-theme-choice={theme.id} aria-pressed={theme.id === 'meadow'}>
        <span class="theme-preview" style={{ backgroundImage: `url("${theme.wallpaper.src}")` }} aria-hidden="true"></span>
        <span>{theme.label}</span>
      </button>
    ))}
  </div>
  <label class="era-picker" hidden>
    <span>Desktop year <output>2001 · XP</output></span>
    <input type="range" min="0" max={desktopEras.length - 1} step="1" value="1" aria-label="Desktop year" aria-valuetext="2001, Windows XP" />
  </label>
</fieldset>
