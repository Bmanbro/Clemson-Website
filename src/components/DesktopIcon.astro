---
const { kind = 'folder' } = Astro.props;
---
<svg class="desktop-icon" viewBox="0 0 16 16" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true">
  {kind === 'profile' ? <>
    <path fill="#35434e" d="M1 1h14v10H1zM6 11h4v2H6zM3 13h10v2H3z" />
    <path fill="#c1c9c6" d="M2 2h12v8H2zM4 13h8v1H4z" />
    <path fill="#6d969c" d="M3 3h10v6H3z" /><path fill="#ede8d4" d="M6 4h3v2H6zM5 7h5v2H5z" />
  </> : kind === 'shield' ? <>
    <path fill="#343f4e" d="m8 0 7 3v6l-3 4-4 3-4-3-3-4V3z" />
    <path fill="#b3c2c6" d="m8 2 5 2v5l-2 3-3 2-3-2-2-3V4z" />
    <path fill="#537892" d="m8 3 4 2v4l-2 2-2 2z" /><path fill="#d6c68b" d="M5 6h6v2H5zM7 4h2v7H7z" />
  </> : <>
    <path fill="#655c3d" d="M1 3h5l2 2h7v9H1z" /><path fill="#ddca8b" d="M2 4h4l2 2h6v7H2z" />
    <path fill="#9b8956" d="M1 7h14l-2 7H0z" /><path fill="#d3c18b" d="M2 8h12l-2 5H1z" /><path fill="#eee1b5" d="M2 8h12v1H2z" />
  </>}
</svg>
