---
import { profile as p } from '../data/profile';
---
<section id="education" class="credential"><h2>Education</h2><h3>{p.education.school}</h3><p>{p.education.degree}<br />{p.education.minor}</p><p>{p.education.graduation}<br />GPA {p.education.gpa}</p></section>
<section id="skills" class="credential"><h2>Skills</h2><h3>Programming</h3><ul class="skill-list">{p.languages.map((s) => <li>{s}</li>)}</ul><h3>Security tools</h3><ul class="skill-list">{p.tools.map((s) => <li>{s}</li>)}</ul></section>
