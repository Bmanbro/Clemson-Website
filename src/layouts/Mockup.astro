---
import '@fontsource/anton/latin-400.css';
import '../styles/base.css';
const { title, theme } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Bryson Newman. Computer science, cybersecurity, and firewall operations at Clemson University." />
    <title>{title} | Bryson Newman</title>
  </head>
  <body class={theme}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="review-bar"><a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/mockups/`}>All mockups</a><span>Design preview / {theme === 'mixtape' ? 'A · Mixtape desktop' : 'B · 2003 personal portal'}</span><a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/mockups/${theme === 'mixtape' ? 'portal' : 'mixtape'}`}>View concept {theme === 'mixtape' ? 'B' : 'A'}</a></div>
    <slot />
  </body>
</html>
