---
import cursorArrow from '../assets/cursor-arrow-portrait.png';
import cursorHand from '../assets/cursor-hand-portrait.png';
import { themes } from '../data/themes';
const themeIds = themes.map(theme => theme.id);

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#58818c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/bryson-icon.png`} />
    <title>{title}</title>
  </head>
  <body class="portal" data-lofi="on" data-theme="meadow" style={{
    ...Object.fromEntries(themes.map(theme => [`--wallpaper-${theme.id}`, `url("${theme.wallpaper.src}")`])),
    '--cursor-arrow': `url("${cursorArrow.src}") 2 4, default`,
    '--cursor-hand': `url("${cursorHand.src}") 8 2, pointer`,
  }}>
    <script is:inline define:vars={{ themeIds }}>
      // Apply preferences before any visible content is painted.
      (() => {
        let lofi = 'on';
        let motion = 'playing';
        let theme = 'meadow';
        try {
          if (localStorage.getItem('bryson-lofi') === 'off') lofi = 'off';
          if (localStorage.getItem('bryson-motion') === 'paused') motion = 'paused';
          const savedTheme = localStorage.getItem('bryson-theme');
          if (themeIds.includes(savedTheme)) theme = savedTheme;
        } catch {}
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) motion = 'paused';
        document.body.dataset.theme = theme;
        document.body.dataset.lofi = lofi;
        document.body.dataset.motion = motion;
        if (motion === 'paused') document.documentElement.style.scrollBehavior = 'auto';
      })();
    </script>
    <slot />
  </body>
</html>
